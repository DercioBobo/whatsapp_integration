        "last_error"
    ],
    "fields": [
        {
            "default": "1",
            "fieldname": "enabled",
            "fieldtype": "Check",
            "in_list_view": 1,
            "label": "Enabled"
        },
        {
            "fieldname": "report_name",
            "fieldtype": "Data",
            "in_list_view": 1,
            "label": "Name",
            "reqd": 1,
            "unique": 1
        },
        {
            "fieldname": "section_report",
            "fieldtype": "Section Break",
            "label": "Report Configuration"
        },
        {
            "fieldname": "source",
            "fieldtype": "Select",
            "label": "Source",
            "options": "Report\nDocument List",
            "default": "Report",
            "description": "Report: send a saved Frappe report. Document List: send a text list of documents (e.g. pending invoices), optionally one message per person."
        },
        {
            "fieldname": "report",
            "fieldtype": "Link",
            "in_list_view": 1,
            "label": "Report",
            "options": "Report",
            "depends_on": "eval:doc.source!='Document List'",
            "mandatory_depends_on": "eval:doc.source!='Document List'"
        },
        {
            "fieldname": "report_type",
            "fieldtype": "Select",
            "label": "Report Type",
            "options": "Report Builder\nQuery Report\nScript Report",
            "read_only": 1,
            "fetch_from": "report.report_type",
            "depends_on": "eval:doc.source!='Document List'"
        },
        {
            "fieldname": "column_break_report",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "user",
            "fieldtype": "Link",
            "label": "Run As User",
            "options": "User",
            "description": "Report will be generated with this user's permissions",
            "default": "Administrator",
            "depends_on": "eval:doc.source!='Document List'"
        },
        {
            "fieldname": "filters",
            "fieldtype": "Code",
            "label": "Filters (JSON)",
            "options": "JSON",
            "description": "Report filters in JSON format. Example: {\"company\": \"My Company\"}",
            "depends_on": "eval:doc.source!='Document List'"
        },
        {
            "fieldname": "dynamic_filters",
            "fieldtype": "Small Text",
            "label": "Dynamic Date Filters",
            "description": "Use: today, yesterday, this_week, last_week, this_month, last_month, this_quarter, last_quarter, this_year, last_year",
            "depends_on": "eval:doc.source!='Document List'"
        },
        {
            "fieldname": "section_document_list",
            "fieldtype": "Section Break",
            "label": "Document List",
            "depends_on": "eval:doc.source=='Document List'"
        },
        {
            "fieldname": "list_doctype",
            "fieldtype": "Link",
            "label": "Document Type",
            "options": "DocType",
            "depends_on": "eval:doc.source=='Document List'",
            "mandatory_depends_on": "eval:doc.source=='Document List'"
        },
        {
            "fieldname": "list_filters",
            "fieldtype": "Code",
            "label": "Document Filters",
            "options": "JSON",
            "depends_on": "eval:doc.source=='Document List'",
            "description": "Frappe filters. Example: [[\"docstatus\",\"=\",1],[\"outstanding_amount\",\">\",0]]. Timespans work too: [\"posting_date\",\"Timespan\",\"this month\"]"
        },
        {
            "fieldname": "edit_list_filters_button",
            "fieldtype": "Button",
            "label": "Edit Filters",
            "depends_on": "eval:doc.source=='Document List'"
        },
        {
            "fieldname": "column_break_document_list",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "list_order_by",
            "fieldtype": "Data",
            "label": "Sort By",
            "default": "creation desc",
            "depends_on": "eval:doc.source=='Document List'",
            "description": "e.g. due_date asc, outstanding_amount desc"
        },
        {
            "fieldname": "list_limit",
            "fieldtype": "Int",
            "label": "Documents Listed per Message",
            "default": "20",
            "depends_on": "eval:doc.source=='Document List'",
            "description": "The rest are counted as '…and N more'. Totals always cover every matching document."
        },
        {
            "fieldname": "split_by_field",
            "fieldtype": "Select",
            "label": "Split by (one message per person)",
            "depends_on": "eval:doc.source=='Document List'",
            "description": "Each person gets only their own documents, sent to the phone on their record (User, Employee, Sales Person, Customer...)."
        },
        {
            "fieldname": "split_phone_field",
            "fieldtype": "Data",
            "label": "Phone Field on Linked Record",
            "depends_on": "eval:doc.source=='Document List' && doc.split_by_field",
            "description": "Optional. Leave empty to auto-detect (mobile_no, cell_number, phone...)."
        },
        {
            "fieldname": "section_schedule",
            "fieldtype": "Section Break",
            "label": "Schedule"
        },
        {
            "fieldname": "frequency",
            "fieldtype": "Select",
            "in_list_view": 1,
            "label": "Frequency",
            "options": "Daily\nWeekly\nMonthly\nQuarterly",
            "default": "Daily",
            "reqd": 1
        },
        {
            "fieldname": "day_of_week",
            "fieldtype": "Select",
            "label": "Day of Week",
            "options": "\nMonday\nTuesday\nWednesday\nThursday\nFriday\nSaturday\nSunday",
            "depends_on": "eval:doc.frequency=='Weekly'",
            "mandatory_depends_on": "eval:doc.frequency=='Weekly'"
        },
        {
            "fieldname": "column_break_schedule",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "day_of_month",
            "fieldtype": "Int",
            "label": "Day of Month",
            "default": "1",
            "description": "1-28 (use 1 for first day, 28 for safety on all months)",
            "depends_on": "eval:doc.frequency=='Monthly' || doc.frequency=='Quarterly'",
            "mandatory_depends_on": "eval:doc.frequency=='Monthly' || doc.frequency=='Quarterly'"
        },
        {
            "fieldname": "send_time",
            "fieldtype": "Time",
            "label": "Send Time",
            "default": "08:00:00",
            "reqd": 1,
            "description": "Time to send the report (server timezone)"
        },
        {
            "fieldname": "section_recipients",
            "fieldtype": "Section Break",
            "label": "Recipients"
        },
        {
            "fieldname": "recipients",
            "fieldtype": "Small Text",
            "label": "Recipients",
            "description": "WhatsApp phone numbers (one per line). With Document List they receive the full list."
        },
        {
            "fieldname": "group_id",
            "fieldtype": "Data",
            "label": "WhatsApp Group ID",
            "read_only": 1,
            "depends_on": "eval:doc.source=='Document List'",
            "description": "The group receives the full list"
        },
        {
            "fieldname": "group_name",
            "fieldtype": "Data",
            "label": "Group Name",
            "read_only": 1,
            "depends_on": "eval:doc.group_id"
        },
        {
            "fieldname": "select_group_button",
            "fieldtype": "Button",
            "label": "Select Group",
            "depends_on": "eval:doc.source=='Document List'"
        },
        {
            "fieldname": "column_break_recipients",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "no_of_rows",
            "fieldtype": "Int",
            "label": "Max Rows",
            "default": "500",
            "description": "Maximum rows to include in report (0 = unlimited)",
            "depends_on": "eval:doc.source!='Document List'"
        },
        {
            "fieldname": "send_if_data",
            "fieldtype": "Check",
            "label": "Send Only If Data",
            "default": "1",
            "description": "Only send if the report returns data"
        },
        {
            "default": "0",
            "fieldname": "mention_everyone",
            "fieldtype": "Check",
            "label": "Tag Everyone in Group",
            "depends_on": "eval:doc.source=='Document List' && doc.group_id"
        },
        {
            "fieldname": "group_mentions",
            "fieldtype": "Small Text",
            "label": "Members to Tag",
            "depends_on": "eval:doc.source=='Document List' && doc.group_id",
            "description": "Phone numbers to tag in the group message (one per line)"
        },
        {
            "fieldname": "select_mentions_button",
            "fieldtype": "Button",
            "label": "Select Members to Tag",
            "depends_on": "eval:doc.source=='Document List' && doc.group_id"
        },
        {
            "fieldname": "section_format",
            "fieldtype": "Section Break",
            "label": "Format & Attachments",
            "depends_on": "eval:doc.source!='Document List'"
        },
        {
            "fieldname": "format",
            "fieldtype": "Select",
            "label": "Primary Format",
            "options": "Text Summary\nPDF\nExcel",
            "default": "Text Summary"
        },
        {
            "fieldname": "include_pdf",
            "fieldtype": "Check",
            "label": "Include PDF Attachment",
            "default": "0"
        },
        {
            "fieldname": "include_excel",
            "fieldtype": "Check",
            "label": "Include Excel Attachment",
            "default": "1"
        },
        {
            "fieldname": "column_break_format",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "pdf_print_format",
            "fieldtype": "Link",
            "label": "PDF Print Format",
            "options": "Print Format",
            "depends_on": "include_pdf",
            "description": "Optional custom print format for PDF"
        },
        {
            "fieldname": "section_message",
            "fieldtype": "Section Break",
            "label": "Message"
        },
        {
            "fieldname": "message_template",
            "fieldtype": "Code",
            "label": "Message Template",
            "options": "Jinja",
            "description": "Jinja2 template. Report: {{ report_name }}, {{ date }}, {{ rows }}, {{ summary }}. Document List: {{ docs }}, {{ count }}, {{ more }}, {{ total('field') }}, {{ recipient_name }}, {{ link }}, {{ mentions }}. Leave empty for a default message."
        },
        {
            "fieldname": "include_summary",
            "fieldtype": "Check",
            "label": "Include Data Summary in Message",
            "default": "1",
            "description": "Include first few rows as text in the message",
            "depends_on": "eval:doc.source!='Document List'"
        },
        {
            "fieldname": "include_link",
            "fieldtype": "Check",
            "label": "Include Report Link",
            "default": "0",
            "description": "Include link to view report in ERPNext"
        },
        {
            "fieldname": "section_status",
            "fieldtype": "Section Break",
            "label": "Status",
            "collapsible": 1
        },
        {
            "fieldname": "last_sent",
            "fieldtype": "Datetime",
            "label": "Last Sent",
            "read_only": 1
        },
        {
            "fieldname": "last_status",
            "fieldtype": "Data",
            "label": "Last Status",
            "read_only": 1
        },
        {
            "fieldname": "last_error",
            "fieldtype": "Small Text",
            "label": "Last Error",
            "read_only": 1
        }
    ],
    "index_web_pages_for_search": 1,
    "links": [],
