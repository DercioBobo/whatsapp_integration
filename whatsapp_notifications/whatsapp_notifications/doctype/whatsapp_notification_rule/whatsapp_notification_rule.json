    "fields": [
        {
            "default": "1",
            "fieldname": "enabled",
            "fieldtype": "Check",
            "in_list_view": 1,
            "label": "Enabled"
        },
        {
            "fieldname": "rule_name",
            "fieldtype": "Data",
            "in_list_view": 1,
            "label": "Rule Name",
            "reqd": 1,
            "unique": 1
        },
        {
            "fieldname": "section_trigger",
            "fieldtype": "Section Break",
            "label": "Trigger Configuration"
        },
        {
            "fieldname": "document_type",
            "fieldtype": "Link",
            "in_list_view": 1,
            "label": "Document Type",
            "options": "DocType",
            "reqd": 1,
            "description": "DocType that triggers this notification"
        },
        {
            "fieldname": "event",
            "fieldtype": "Select",
            "in_list_view": 1,
            "label": "Event",
            "options": "After Insert\nOn Update\nOn Submit\nOn Cancel\nOn Change\nOn Trash\nDays Before\nDays After\nOn Same Day\nRecurring",
            "reqd": 1,
            "default": "After Insert"
        },
        {
            "fieldname": "column_break_trigger",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "condition",
            "fieldtype": "Code",
            "label": "Condition (Optional)",
            "description": "Jinja2 condition. Send only if evaluates to True. Example: {{ doc.status == 'Approved' }}",
            "options": "Jinja"
        },
        {
            "fieldname": "value_changed",
            "fieldtype": "Data",
            "label": "Watch Fields (Parent)",
            "description": "Comma-separated parent field names to monitor. Only fires when at least one of these fields changed. Leave empty to always fire.",
            "depends_on": "eval:doc.event=='On Change' || doc.event=='On Update'"
        },
        {
            "fieldname": "days_offset",
            "fieldtype": "Int",
            "label": "Days Offset",
            "description": "Number of days before or after the date field to trigger.",
            "depends_on": "eval:doc.event=='Days Before' || doc.event=='Days After'",
            "mandatory_depends_on": "eval:doc.event=='Days Before' || doc.event=='Days After'"
        },
        {
            "fieldname": "date_field",
            "fieldtype": "Select",
            "label": "Date Field",
            "description": "Date or Datetime field to use for scheduling. For Recurring it is optional and powers {{ days_overdue }} and 'Only After Date Field'.",
            "depends_on": "eval:['Days Before','Days After','On Same Day','Recurring'].includes(doc.event)",
            "mandatory_depends_on": "eval:doc.event=='Days Before' || doc.event=='Days After' || doc.event=='On Same Day'"
        },
        {
            "fieldname": "section_recurring",
            "fieldtype": "Section Break",
            "label": "Recurring Schedule",
            "depends_on": "eval:doc.event=='Recurring'",
            "description": "Sends one message per matching document on every run. Reminders stop by themselves once a document no longer matches the filters (e.g. the invoice is paid)."
        },
        {
            "fieldname": "recurring_frequency",
            "fieldtype": "Select",
            "label": "Frequency",
            "options": "Daily\nWeekly\nMonthly",
            "default": "Daily",
            "depends_on": "eval:doc.event=='Recurring'",
            "mandatory_depends_on": "eval:doc.event=='Recurring'"
        },
        {
            "fieldname": "recurring_day_of_week",
            "fieldtype": "Select",
            "label": "Day of Week",
            "options": "\nMonday\nTuesday\nWednesday\nThursday\nFriday\nSaturday\nSunday",
            "depends_on": "eval:doc.event=='Recurring' && doc.recurring_frequency=='Weekly'",
            "mandatory_depends_on": "eval:doc.event=='Recurring' && doc.recurring_frequency=='Weekly'"
        },
        {
            "fieldname": "recurring_day_of_month",
            "fieldtype": "Int",
            "label": "Day of Month",
            "description": "1-31. Days beyond the month's end run on its last day (e.g. 31 runs on Feb 28).",
            "depends_on": "eval:doc.event=='Recurring' && doc.recurring_frequency=='Monthly'",
            "mandatory_depends_on": "eval:doc.event=='Recurring' && doc.recurring_frequency=='Monthly'"
        },
        {
            "fieldname": "recurring_send_time",
            "fieldtype": "Time",
            "label": "Send Time",
            "description": "Server time. Leave empty to use the Scheduled Rules Run Hour from Evolution API Settings.",
            "depends_on": "eval:doc.event=='Recurring'"
        },
        {
            "fieldname": "recurring_max_reminders",
            "fieldtype": "Int",
            "label": "Max Reminders per Document",
            "default": "0",
            "description": "Stop after this many reminders for the same document. 0 = no limit.",
            "depends_on": "eval:doc.event=='Recurring'"
        },
        {
            "fieldname": "column_break_recurring",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "recurring_filters",
            "fieldtype": "Code",
            "label": "Document Filters",
            "options": "JSON",
            "description": "Use the Edit Filters button, or type a list of [field, operator, value]. Example: [[\"posting_date\", \"Timespan\", \"this month\"], [\"outstanding_amount\", \">\", 0]]",
            "depends_on": "eval:doc.event=='Recurring'"
        },
        {
            "fieldname": "edit_recurring_filters_button",
            "fieldtype": "Button",
            "label": "Edit Filters",
            "depends_on": "eval:doc.event=='Recurring'"
        },
        {
            "default": "0",
            "fieldname": "recurring_start_after_date",
            "fieldtype": "Check",
            "label": "Only After Date Field",
            "description": "Only remind once the Date Field (plus the offset below) has been reached, e.g. only overdue invoices.",
            "depends_on": "eval:doc.event=='Recurring' && doc.date_field"
        },
        {
            "fieldname": "recurring_start_days",
            "fieldtype": "Int",
            "label": "Start Offset (Days)",
            "default": "0",
            "description": "Days after the Date Field to start reminding. Negative = start before it (e.g. -3 = three days before due).",
            "depends_on": "eval:doc.event=='Recurring' && doc.date_field && doc.recurring_start_after_date"
        },
        {
            "fieldname": "recurring_last_run",
            "fieldtype": "Datetime",
            "label": "Last Run",
            "read_only": 1,
            "no_copy": 1,
            "depends_on": "eval:doc.event=='Recurring' && doc.recurring_last_run"
        },
        {
            "fieldname": "section_recipient",
            "fieldtype": "Section Break",
            "label": "Recipient Configuration"
        },
        {
            "fieldname": "recipient_type",
            "fieldtype": "Select",
            "label": "Recipient Type",
            "options": "Document Contact\nFixed Numbers\nDocument + Fixed\nWhatsApp Group\nDocument + Group",
            "default": "Document Contact",
            "description": "How to determine recipients"
        },
        {
            "default": "0",
            "fieldname": "use_child_table",
            "fieldtype": "Check",
            "label": "Use Child Table",
            "description": "Get phone numbers from a child table field",
            "depends_on": "eval:['Document Contact','Document + Fixed','Document + Group'].includes(doc.recipient_type)"
        },
        {
            "fieldname": "phone_field",
            "fieldtype": "Data",
            "label": "Phone Field",
            "description": "Comma-separated document field names containing recipient phone numbers",
            "depends_on": "eval:['Document Contact','Document + Fixed','Document + Group'].includes(doc.recipient_type) && !doc.use_child_table"
        },
        {
            "fieldname": "child_table",
            "fieldtype": "Select",
            "label": "Child Table",
            "description": "Child table field to iterate for recipients",
            "depends_on": "eval:doc.use_child_table==1"
        },
        {
            "fieldname": "child_phone_field",
            "fieldtype": "Data",
            "label": "Child Phone Field",
            "description": "Comma-separated field names in child table containing phone numbers",
            "depends_on": "eval:doc.use_child_table==1 && doc.child_table"
        },
        {
            "fieldname": "column_break_recipient",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "fixed_recipients",
            "fieldtype": "Small Text",
            "label": "Fixed Recipients",
            "description": "Phone numbers to always receive this notification (one per line or comma/semicolon separated)",
            "depends_on": "eval:doc.recipient_type=='Fixed Numbers' || doc.recipient_type=='Document + Fixed'"
        },
        {
            "fieldname": "group_id",
            "fieldtype": "Data",
            "label": "WhatsApp Group ID",
            "description": "The WhatsApp group ID (ending with @g.us)",
            "depends_on": "eval:doc.recipient_type=='WhatsApp Group' || doc.recipient_type=='Document + Group'",
            "read_only": 1
        },
        {
            "fieldname": "group_name",
            "fieldtype": "Data",
            "label": "Group Name",
            "read_only": 1,
            "depends_on": "eval:doc.group_id"
        },
        {
            "fieldname": "select_group_button",
            "fieldtype": "Button",
            "label": "Select Group",
            "depends_on": "eval:doc.recipient_type=='WhatsApp Group' || doc.recipient_type=='Document + Group'"
        },
        {
            "fieldname": "section_group_mentions",
            "fieldtype": "Section Break",
            "label": "Tag Group Members",
            "collapsible": 1,
            "collapsible_depends_on": "eval:doc.mention_everyone || doc.group_mentions || doc.group_mention_fields",
            "depends_on": "eval:(doc.recipient_type=='WhatsApp Group' || doc.recipient_type=='Document + Group') && doc.group_id",
            "description": "Tag (@mention) members in the group message. Use {{ mentions }} in the template to place the tags; otherwise they are appended at the end of the message."
        },
        {
            "default": "0",
            "fieldname": "mention_everyone",
            "fieldtype": "Check",
            "label": "Tag Everyone",
            "description": "Notify all group members (silent @everyone mention)"
        },
        {
            "fieldname": "group_mention_fields",
            "fieldtype": "Data",
            "label": "Tag From Document Fields",
            "description": "Comma-separated document fields with phone numbers to tag (e.g. the assigned user's mobile)"
        },
        {
            "fieldname": "column_break_group_mentions",
            "fieldtype": "Column Break"
        },
        {
            "fieldname": "group_mentions",
            "fieldtype": "Small Text",
            "label": "Members to Tag",
            "description": "One per line: a number, or role: number (e.g. supervisor: 258841234567). Use {{ tag('supervisor') }} in the template to tag that person in a specific place. Easiest: use Select Members to Tag."
        },
        {
            "fieldname": "select_mentions_button",
            "fieldtype": "Button",
            "label": "Select Members to Tag"
        },
        {
            "fieldname": "section_row_conditions",
            "fieldtype": "Section Break",
            "label": "Row Conditions",
            "depends_on": "eval:doc.use_child_table==1 && doc.child_table"
        },
        {
            "default": "0",
            "fieldname": "only_changed_rows",
            "fieldtype": "Check",
            "label": "Only Changed Rows",
            "description": "Only send for rows that have changed since last save",
            "depends_on": "eval:doc.use_child_table==1 && (doc.event=='On Update' || doc.event=='On Change')"
        },
        {
            "fieldname": "child_watch_fields",
            "fieldtype": "Data",
            "label": "Watch Fields (Child)",
            "description": "Comma-separated child table fields to watch for changes. Empty = watch all fields.",
            "depends_on": "eval:doc.use_child_table==1 && doc.only_changed_rows==1 && doc.child_table"
        },
        {
            "fieldname": "row_condition",
            "fieldtype": "Code",
            "label": "Row Condition",
            "description": "Jinja2 per-row filter. Use {{ row.fieldname }} to check row fields.",
            "options": "Jinja",
            "depends_on": "eval:doc.use_child_table==1 && doc.child_table"
        },
        {
            "fieldname": "section_message",
            "fieldtype": "Section Break",
            "label": "Message Configuration"
        },
        {
            "fieldname": "message_type",
            "fieldtype": "Select",
            "label": "Message Type",
            "options": "Text Only\nAttached File\nDocument PDF\nFixed File",
            "default": "Text Only",
            "description": "Text Only: sends message template. Attached File: sends first attachment. Document PDF: generates PDF from print format. Fixed File: sends a specific file."
        },
        {
            "fieldname": "print_format",
            "fieldtype": "Data",
            "label": "Print Format",
            "description": "Print format to use for PDF generation. Leave empty for 'Standard'",
            "depends_on": "eval:doc.message_type=='Document PDF'"
        },
        {
            "fieldname": "fixed_file",
            "fieldtype": "Attach",
            "label": "Fixed File",
            "description": "Select or upload a file to always send with this rule",
            "depends_on": "eval:doc.message_type=='Fixed File'"
        },
        {
            "default": "0",
            "fieldname": "send_previous_day",
            "fieldtype": "Check",
            "label": "Also Send on Previous Day",
            "description": "Send a separate message the day before the date field. Fires when date_field = tomorrow.",
            "depends_on": "eval:doc.event=='On Same Day'"
        },
        {
            "fieldname": "previous_day_template",
            "fieldtype": "Code",
            "label": "Previous Day Message Template",
            "options": "Jinja",
            "description": "Template for the previous-day message. Nothing is sent if left empty.",
            "depends_on": "eval:doc.event=='On Same Day' && doc.send_previous_day"
        },
        {
            "fieldname": "message_template",
            "fieldtype": "Code",
            "label": "Message Template",
            "reqd": 1,
            "options": "Jinja",
            "description": "Jinja2 template for the message. Use {{ doc.fieldname }}, {{ row.fieldname }}, {{ changed_fields }}, {{ changed_values }}, {{ previous_values }}."
        },
        {
            "default": "0",
            "fieldname": "send_next_day",
            "fieldtype": "Check",
            "label": "Also Send on Next Day",
            "description": "Send a separate message the day after the date field. Fires when date_field = yesterday.",
            "depends_on": "eval:doc.event=='On Same Day'"
        },
        {
            "fieldname": "next_day_template",
            "fieldtype": "Code",
            "label": "Next Day Message Template",
            "options": "Jinja",
            "description": "Template for the next-day message. Nothing is sent if left empty.",
            "depends_on": "eval:doc.event=='On Same Day' && doc.send_next_day"
        },
        {
            "fieldname": "section_owner_notification",
            "fieldtype": "Section Break",
            "label": "CC Notification",
            "collapsible": 1
        },
        {
            "default": "0",
            "fieldname": "notify_owner",
            "fieldtype": "Check",
            "label": "Also Send to Default Numbers",
            "description": "Send a separate notification to the default numbers configured in Evolution API Settings"
        },
        {
            "fieldname": "owner_message_template",
            "fieldtype": "Code",
            "label": "Message Template for Default Recipients",
            "options": "Jinja",
            "description": "Separate template for default recipients notification. If empty, uses the same template.",
            "depends_on": "notify_owner"
        },
        {
            "fieldname": "section_advanced",
            "fieldtype": "Section Break",
            "label": "Advanced Options",
            "collapsible": 1
        },
        {
            "default": "1 - High",
            "fieldname": "priority",
            "fieldtype": "Select",
            "label": "Priority",
            "options": "1 - High\n2 - Medium\n3 - Low",
            "description": "Higher priority messages are sent first"
        },
        {
            "default": "0",
            "fieldname": "delay_seconds",
            "fieldtype": "Int",
            "label": "Delay (seconds)",
            "description": "Wait this many seconds before sending"
        },
        {
            "fieldname": "column_break_advanced",
            "fieldtype": "Column Break"
        },
        {
            "default": "0",
            "fieldname": "send_once",
            "fieldtype": "Check",
            "label": "Send Only Once Per Document",
            "description": "Don't send again if this rule already sent for this document",
            "depends_on": "eval:doc.event!='Recurring'"
        },
        {
            "fieldname": "active_days",
            "fieldtype": "Data",
            "label": "Active Days",
            "description": "Comma-separated days (Mon,Tue,Wed,Thu,Fri,Sat,Sun). Empty = all days.",
            "placeholder": "Mon,Tue,Wed,Thu,Fri"
        },
        {
            "default": "0",
            "fieldname": "enable_active_hours",
            "fieldtype": "Check",
            "label": "Restrict to Active Hours",
            "description": "Only send notifications during specific hours"
        },
        {
            "fieldname": "active_hours_start",
            "fieldtype": "Data",
            "label": "Active Hours Start",
            "depends_on": "enable_active_hours",
            "mandatory_depends_on": "enable_active_hours",
            "placeholder": "HH:MM (e.g., 09:00)",
            "description": "Start time in 24-hour format"
        },
        {
            "fieldname": "active_hours_end",
            "fieldtype": "Data",
            "label": "Active Hours End",
            "depends_on": "enable_active_hours",
            "mandatory_depends_on": "enable_active_hours",
            "placeholder": "HH:MM (e.g., 18:00)",
            "description": "End time in 24-hour format"
        }
    ],
    "index_web_pages_for_search": 1,
